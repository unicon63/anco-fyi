# Google Sheets service account credentials (JSON stringified)
# 1. Go to console.cloud.google.com → Create/select a project
# 2. Enable "Google Sheets API"
# 3. Create a service account → generate JSON key
# 4. Copy the entire JSON key file content, minify it, and paste below
# 5. Share the Google Sheet with the service account email (Editor access)
#
# The Sheet ID is: 1zmUlnAMNemOQ3Ne2Mlm_X0M4cdPa8lz0L9ikpKxleyw
# Create a sheet tab named "RSVPs" with headers in row 1:
#   Timestamp | Name | Email | Attendance | Address Line 1 | Address Line 2 | City/Postcode | Country | Dietary Requirements | Accommodation Preference

GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
